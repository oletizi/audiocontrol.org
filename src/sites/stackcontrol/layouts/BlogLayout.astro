---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  date?: string;
  datePublished?: string;
  dateModified?: string;
  author?: string;
  phase?: string;
}

const {
  title,
  description,
  date,
  datePublished,
  dateModified,
  author = 'Orion Letizi',
  phase,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedModified = dateModified ?? datePublished;

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished,
  dateModified: resolvedModified,
  author: { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'stackcontrol.org',
    logo: { '@type': 'ImageObject', url: 'https://stackcontrol.org/favicon.svg' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
};
---

<Layout title={title} description={description} type="article" jsonLd={blogPostingJsonLd}>
  <article class="entry site-container">
    <header class="entry-header">
      <p class="kicker">Devlog{phase ? ` · ${phase}` : ''}</p>
      <h1 class="entry-title">{title}</h1>
      {description && <p class="entry-subtitle">{description}</p>}
      <div class="entry-meta">
        {datePublished && (
          <time class="meta-date tabular" datetime={datePublished}>{date ?? datePublished}</time>
        )}
        <span class="meta-dot" aria-hidden="true">//</span>
        <span class="meta-author">{author}</span>
      </div>
      <hr class="rule-accent" />
    </header>

    <div class="entry-body">
      <slot />
    </div>

    <footer class="entry-footer">
      <a class="back-link" href="/blog/"><span class="arr" aria-hidden="true">←</span> All devlog entries</a>
    </footer>
  </article>
</Layout>

<style>
  .entry {
    padding-top: 3rem;
    padding-bottom: 4rem;
    max-width: 52rem;
  }

  .entry-header { margin-bottom: 2.5rem; }
  .kicker { margin-bottom: 1rem; }

  .entry-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: hsl(var(--foreground));
    margin: 0 0 1rem;
  }

  .entry-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.45;
    color: hsl(var(--muted-foreground));
    margin: 0 0 1.25rem;
    max-width: 44rem;
  }

  .entry-meta {
    display: flex;
    align-items: baseline;
    gap: 0.8ch;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .meta-date { color: hsl(var(--accent)); }
  .meta-dot { color: hsl(var(--primary)); }

  /* ---- Body typography ---- */
  .entry-body {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: hsl(var(--foreground) / 0.93);
    max-width: var(--measure-reading);
  }

  .entry-body :global(h2) {
    font-family: var(--font-display-tight);
    font-weight: 800;
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: hsl(var(--foreground));
    margin: 2.75rem 0 1rem;
    scroll-margin-top: 5rem;
  }

  .entry-body :global(h3) {
    font-family: var(--font-display-tight);
    font-weight: 700;
    font-size: 1.25rem;
    color: hsl(var(--foreground));
    margin: 2rem 0 0.75rem;
  }

  .entry-body :global(p) { margin: 0 0 1.25rem; }

  .entry-body :global(strong) { color: hsl(var(--foreground)); font-weight: 600; }
  .entry-body :global(em) { color: hsl(var(--accent)); font-style: italic; }

  .entry-body :global(a) {
    color: hsl(var(--primary));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--primary) / 0.4);
    transition: border-color 0.15s ease;
  }
  .entry-body :global(a:hover) { border-bottom-color: hsl(var(--primary)); text-decoration: none; }

  .entry-body :global(ul), .entry-body :global(ol) { margin: 0 0 1.25rem; padding-left: 1.5rem; }
  .entry-body :global(li) { margin-bottom: 0.5rem; }
  .entry-body :global(li)::marker { color: hsl(var(--primary)); }

  .entry-body :global(blockquote) {
    margin: 2rem 0;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid hsl(var(--primary));
    font-style: italic;
    color: hsl(var(--accent));
  }

  .entry-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: hsl(var(--card));
    padding: 0.1rem 0.4rem;
    color: hsl(var(--primary));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
  }

  .entry-body :global(pre) {
    background: hsl(var(--card));
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .entry-body :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    color: hsl(var(--foreground));
  }

  .entry-body :global(hr) {
    border: 0;
    border-top: 1px solid hsl(var(--border));
    margin: 2.5rem 0;
  }

  /* ---- Footer ---- */
  .entry-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid hsl(var(--border));
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }
  .back-link:hover { color: hsl(var(--primary)); text-decoration: none; }
</style>
