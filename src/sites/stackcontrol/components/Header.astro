---
// Phase 1 placeholder header. Nav + treatment finalized in Phase 3.
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="site-container header-inner">
    <a href="/" class="header-home" aria-label="stackcontrol.org home">
      <Logo variant="header" />
    </a>
    <nav class="header-nav" aria-label="Primary">
      <a href="/blog/">Devlog</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--rule-hairline) solid hsl(var(--border));
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .header-home {
    text-decoration: none;
  }

  .header-home:hover {
    text-decoration: none;
  }

  .header-nav {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .header-nav a {
    color: hsl(var(--muted-foreground));
  }

  .header-nav a:hover {
    color: hsl(var(--primary));
    text-decoration: none;
  }
</style>
