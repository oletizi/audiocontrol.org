---
// Sticky control-plane header: wordmark + mono nav with cyan underline reveal.
import Logo from './Logo.astro';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-container header-row">
    <a class="header-home" href="/" aria-label="stackcontrol.org home">
      <Logo variant="header" />
    </a>
    <nav class="main-nav" aria-label="Primary">
      <a href="/#method">Method</a>
      <a href="/#product">Product</a>
      <a href="/blog/" class:list={[{ active: isActive('/blog') }]}>Devlog</a>
      <a href="/#how">About</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: hsl(var(--background) / 0.82);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid hsl(var(--border));
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .header-home { text-decoration: none; }
  .header-home:hover { text-decoration: none; }

  .main-nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .main-nav a {
    color: hsl(var(--muted-foreground));
    position: relative;
    padding-bottom: 4px;
  }

  .main-nav a.active { color: hsl(var(--foreground)); }

  .main-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: hsl(var(--primary));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .main-nav a:hover { color: hsl(var(--foreground)); text-decoration: none; }
  .main-nav a:hover::after,
  .main-nav a.active::after { transform: scaleX(1); }

  @media (max-width: 560px) {
    .header-row { flex-wrap: wrap; row-gap: 0.85rem; }
    .main-nav {
      flex-basis: 100%;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.6875rem;
    }
  }
</style>
