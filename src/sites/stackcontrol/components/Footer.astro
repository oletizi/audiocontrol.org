---
// Phase 1 placeholder footer.
import { brand } from '../brand.js';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-container footer-inner">
    <p class="footer-name">{brand.name}</p>
    <nav class="footer-siblings" aria-label="Sibling sites">
      <a href="https://audiocontrol.org">audiocontrol.org</a>
      <a href="https://editorialcontrol.org">editorialcontrol.org</a>
    </nav>
    <p class="footer-copy tabular">© {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule-hairline) solid hsl(var(--border));
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: hsl(var(--muted-foreground));
  }

  .footer-name {
    color: hsl(var(--foreground));
  }

  .footer-siblings {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }

  .footer-siblings a {
    color: hsl(var(--muted-foreground));
  }

  .footer-siblings a:hover {
    color: hsl(var(--primary));
    text-decoration: none;
  }
</style>
