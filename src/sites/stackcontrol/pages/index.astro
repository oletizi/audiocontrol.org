---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout
  title="stackcontrol.org — lifecycle tooling for agentic development"
  description="The home of the deskwork lifecycle plugin: feature definition, workplans, scope discovery, and audit barrages for agentic coding workflows. Product page and devlog."
>
  <section class="hero site-container">
    <p class="kicker">Phase 1 scaffold — identity in progress</p>
    <h1 class="hero-mark">
      <Logo variant="masthead" />
    </h1>
    <p class="hero-lede">
      Lifecycle tooling for agentic development. The public home of the
      <strong>deskwork</strong> plugin — feature definition, workplans, scope discovery, and
      audit barrages — and the devlog of building it in the open.
    </p>
    <p class="hero-note">
      This is a placeholder skeleton. The visual identity is being established under the
      design-decisions protocol; the four real surfaces land once a direction is chosen.
    </p>
    <hr class="rule-accent" />
  </section>
</Layout>

<style>
  .hero {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: 3rem;
    max-width: var(--container-max-width);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    margin: 0 0 1.5rem 0;
  }

  .hero-mark {
    margin: 0 0 1.75rem 0;
  }

  .hero-lede {
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    max-width: 44rem;
    color: hsl(var(--foreground));
    margin: 0 0 1.25rem 0;
    text-wrap: pretty;
  }

  .hero-lede strong {
    color: hsl(var(--primary));
    font-weight: 600;
  }

  .hero-note {
    font-size: var(--text-base);
    color: hsl(var(--muted-foreground));
    max-width: 40rem;
    margin: 0;
  }
</style>
