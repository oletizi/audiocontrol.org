---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true,
);
const posts = entries
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.datePublished,
    displayDate: entry.data.date,
    phase: entry.data.phase,
  }))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Layout
  title="Devlog — stackcontrol.org"
  description="Building the deskwork lifecycle plugin in the open: scope discovery, audit barrages, the editorial pipeline, and the lifecycle that runs it all."
>
  <section class="blog-index site-container">
    <header class="index-head">
      <p class="kicker">Devlog · building in the open</p>
      <h1 class="index-title">Devlog</h1>
      <p class="index-lede">
        Notes from building <strong>deskwork</strong> — the lifecycle toolchain — with the
        lifecycle itself. Each entry is tagged with the phase it's about.
      </p>
      <hr class="rule-accent" />
    </header>

    {posts.length > 0 ? (
      <ol class="entries">
        {posts.map((post, i) => (
          <li class="entry-row">
            <a class="entry-link" href={`/blog/${post.slug}/`}>
              <div class="entry-num tabular">{String(i + 1).padStart(2, '0')}</div>
              <div class="entry-main">
                <div class="entry-meta">
                  <time class="tabular" datetime={post.date}>{post.displayDate ?? post.date}</time>
                  {post.phase && <span class="entry-phase">{post.phase}</span>}
                </div>
                <h2 class="entry-title">{post.title}</h2>
                <p class="entry-desc">{post.description}</p>
              </div>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty mono-note">// no entries published yet — first dispatch incoming</p>
    )}
  </section>
</Layout>

<style>
  .blog-index {
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    max-width: 56rem;
  }

  .index-head { margin-bottom: 2.5rem; }
  .kicker { margin-bottom: 1rem; }

  .index-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .index-lede {
    font-size: 1.0625rem;
    color: hsl(var(--muted-foreground));
    max-width: 48ch;
    margin: 0;
  }
  .index-lede strong { color: hsl(var(--foreground)); font-weight: 600; }

  .entries { list-style: none; padding: 0; margin: 0; }

  .entry-row { border-top: 1px solid hsl(var(--border)); }
  .entry-row:last-child { border-bottom: 1px solid hsl(var(--border)); }

  .entry-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.75rem 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .entry-link:hover { background: hsl(var(--card-hover) / 0.4); text-decoration: none; }
  .entry-link:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: -2px; }

  .entry-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: hsl(var(--primary));
    padding-top: 0.4rem;
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    margin-bottom: 0.6rem;
  }

  .entry-phase {
    padding: 2px 8px;
    border: 1px solid hsl(var(--border-hover));
    border-radius: var(--radius);
    color: hsl(var(--primary));
    font-size: 0.625rem;
    letter-spacing: 0.16em;
  }

  .entry-title {
    font-family: var(--font-display-tight);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: hsl(var(--foreground));
    margin: 0 0 0.5rem;
    transition: color 0.15s ease;
  }
  .entry-link:hover .entry-title { color: hsl(var(--primary)); }

  .entry-desc {
    font-size: 0.9375rem;
    color: hsl(var(--muted-foreground));
    margin: 0;
    max-width: 60ch;
  }

  .go {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: hsl(var(--muted-foreground));
    padding-top: 0.4rem;
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .entry-link:hover .go { color: hsl(var(--primary)); transform: translateX(3px); }

  .mono-note {
    font-family: var(--font-mono);
    color: hsl(var(--accent));
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .entry-link { grid-template-columns: 1fr; gap: 0.6rem; }
    .entry-num, .go { display: none; }
  }
</style>
