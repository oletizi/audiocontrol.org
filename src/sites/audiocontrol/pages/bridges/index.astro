---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {
  parsePageSlots,
  renderSlotBlock,
  renderSlotInline,
} from '../../../../shared/page-slots';

const entry = await getEntry('pages', 'bridges');
if (!entry) {
  throw new Error('Missing content entry: pages/bridges. Expected src/sites/audiocontrol/content/pages/bridges/index.md');
}
const slots = parsePageSlots(entry.body ?? '');

const bridges = entry.data.bridges ?? [];
const available = bridges.filter((b) => b.status === 'available');
const pending = bridges.filter((b) => b.status === 'coming-soon');
---

<Layout
  title={slots.raw.metaTitle ?? slots.raw.title ?? entry.data.description}
  description={entry.data.description}
  image="/images/og/index.png"
>
  <header class="page-header">
    {slots.raw.kicker && (
      <p class="panel-label" set:html={renderSlotInline(slots, 'kicker')} />
    )}
    {slots.raw.title && (
      <h1 class="page-title" set:html={renderSlotInline(slots, 'title')} />
    )}
    {slots.raw.intro && (
      <div class="page-note" set:html={renderSlotBlock(slots, 'intro')} />
    )}
    <hr class="rule-ticked" />
  </header>

  <section class="block" aria-labelledby="available-label">
    <header class="block-header">
      <h2 id="available-label" class="panel-label panel-label--accent" set:html={renderSlotInline(slots, 'availableLabel')} />
      {slots.raw.availableNote && (
        <div class="block-note" set:html={renderSlotBlock(slots, 'availableNote')} />
      )}
    </header>
    <div class="projects-grid projects-grid--featured">
      {available.map((bridge) => (
        <ProjectCard
          name={bridge.name}
          description={bridge.description}
          status={bridge.status}
          href={bridge.slug}
          image={bridge.image}
          meta={bridge.meta}
        />
      ))}
    </div>
  </section>

  {pending.length > 0 && (
    <section class="block" aria-labelledby="pending-label">
      <header class="block-header">
        <h2 id="pending-label" class="panel-label" set:html={renderSlotInline(slots, 'pendingLabel')} />
        {slots.raw.pendingNote && (
          <div class="block-note" set:html={renderSlotBlock(slots, 'pendingNote')} />
        )}
      </header>
      <div class="projects-grid projects-grid--small">
        {pending.map((bridge) => (
          <ProjectCard
            name={bridge.name}
            description={bridge.description}
            status={bridge.status}
            meta={bridge.meta}
          />
        ))}
      </div>
    </section>
  )}

  {slots.raw.closingLabel && slots.raw.closing && (
    <section class="block bridges-note" aria-labelledby="philosophy-label">
      <header class="block-header">
        <h2 id="philosophy-label" class="panel-label" set:html={renderSlotInline(slots, 'closingLabel')} />
      </header>
      <div class="bridges-paragraph" set:html={renderSlotBlock(slots, 'closing')} />
    </section>
  )}
</Layout>

<style>
  .page-header {
    padding: 2.5rem 0 1.5rem;
    max-width: 46rem;
  }

  .page-header .panel-label {
    margin: 0 0 0.75rem 0;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    color: hsl(var(--foreground));
    margin: 0 0 0.85rem 0;
  }

  .page-note {
    font-size: 1rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
    margin: 0 0 1.75rem 0;
  }

  .page-note :global(p) {
    margin: 0 0 1em 0;
  }

  .page-note :global(p:last-child) {
    margin-bottom: 0;
  }

  .block {
    padding: 1.75rem 0 2.5rem;
  }

  .block-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.5rem 0;
    flex-wrap: wrap;
  }

  .block-header .panel-label {
    margin: 0;
  }

  .block-note {
    font-size: 0.9rem;
    color: hsl(var(--muted-foreground));
    margin: 0;
  }

  .block-note :global(p) {
    margin: 0;
  }

  .projects-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .projects-grid--featured {
      grid-template-columns: repeat(2, 1fr);
    }
    .projects-grid--small {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bridges-note {
    border-top: 1px solid hsl(var(--border));
    margin-top: 1rem;
    padding-top: 2.5rem;
  }

  .bridges-paragraph {
    max-width: 46rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.65;
    font-size: 0.98rem;
    margin: 0;
  }

  .bridges-paragraph :global(p) {
    margin: 0 0 1em 0;
  }

  .bridges-paragraph :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
